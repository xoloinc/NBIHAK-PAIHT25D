     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "\n",
    "##landmarkl_extrahering.ipynb\n",
    "\"\"\"Går igenom alla mappar och laddar in 500 bilder från varje mapp, plockar ut landmarks och lägger dessa 21 st till en csv fil\"\"\""
   ]
  },
  {

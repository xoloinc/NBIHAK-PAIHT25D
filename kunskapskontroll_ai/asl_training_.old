     "output_type": "stream",
     "text": [
      "Random Forest tränad!\n"
     ]
    }
   ],
   "source": [
    "from sklearn.ensemble import RandomForestClassifier\n",
    "\n",
    "rf = RandomForestClassifier(n_estimators=100, random_state=42)\n",
    "rf.fit(X_train, y_train)\n",
    "print('Random Forest tränad!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 96,
   "id": "cb0b761d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "SVM tränad!\n"
     ]
    }
   ],
   "source": [
    "\n",
    "from sklearn.svm import SVC\n",
    "\n",
    "svm = SVC(kernel='rbf', C=10, random_state=42)\n",
    "svm.fit(X_train, y_train)\n",
    "print('SVM tränad!')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 97,
   "id": "289ce1de",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "KNN tränad!\n"
     ]
    }
   ],
   "source": [
    "from sklearn.neighbors import KNeighborsClassifier\n",
    "\n",
    "knn = KNeighborsClassifier(n_neighbors=5)\n",
    "knn.fit(X_train, y_train)\n",
    "print('KNN tränad!')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 98,
   "id": "fc7e0a49",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Random Forest: 0.970\n",
